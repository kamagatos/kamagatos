[development]
NODE_ENV=development
API_ENDPOINT=http://localhost:8095
APP_ENDPOINT=http://localhost:8095
HOST=localhost:8095
PATHNAME_STARTS_WITH=/
PORT=8095
STATIC_ENDPOINT=http://localhost:8095/static/apps/blog/web

[onpremise]

[production]
NODE_ENV=production
API_ENDPOINT=https://www.kamagatos.com
APP_ENDPOINT=https://www.kamagatos.com
HOST=www.kamagatos.com
PATHNAME_STARTS_WITH=/
PORT=3000
STATIC_ENDPOINT=https://kamagatos.s3.amazonaws.com/blogweb

[staging]

[test]
NODE_ENV=test
API_ENDPOINT=http://localhost:3001
APP_ENDPOINT=http://localhost:3001
HOST=localhost:3001
PATHNAME_STARTS_WITH=/
PORT=3001
STATIC_ENDPOINT=http://localhost:3001/static/apps/blog/web
